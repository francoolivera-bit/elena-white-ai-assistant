{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "elena-white-ai-api",
  "main": "src/index.js",
  "compatibility_date": "2026-09-01",
  "workers_dev": true,
  "observability": {
    "enabled": true
  },
  // Variables públicas. GEMINI_API_KEY NO va aquí: se guarda con
  //   npx wrangler secret put GEMINI_API_KEY
  "vars": {
    "GEMINI_MODEL": "gemini-3.8-flash",
    // "*" = cualquier origen. Restringe a tu sitio Render cuando lo conozcas, p. ej.:
    // "https://TU-SITIO.onrender.com,http://localhost:5500,http://127.0.0.1:5500"
    "ALLOWED_ORIGINS": "*"
  }
}
